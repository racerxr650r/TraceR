{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gap.fix response",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "kind": {"type": "string", "enum": ["llr", "test"]},
    "llr": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 10},
        "traces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "ref"],
            "properties": {
              "target": {"type": "string"},
              "ref": {"type": "string"},
              "name": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "required": ["name", "purpose"],
      "properties": {
        "name": {"type": "string", "minLength": 3},
        "purpose": {"type": "string", "minLength": 10},
        "traces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "ref"],
            "properties": {
              "target": {"type": "string"},
              "ref": {"type": "string"},
              "name": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {"properties": {"kind": {"const": "llr"}}, "required": ["llr"]},
    {"properties": {"kind": {"const": "test"}}, "required": ["test"]}
  ]
}
